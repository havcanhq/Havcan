# Backend runtime
APP_ENV=development
APP_NAME=HAVCAN API
API_PREFIX=/api
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# MongoDB (optional for Phase 1; the health endpoint remains available when unset)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=havcan

# Browser access during local development
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173