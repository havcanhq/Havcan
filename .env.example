# Backend runtime
APP_ENV=development
APP_NAME=HAVCAN API
API_PREFIX=/api
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# MongoDB (optional for Phase 1; the health endpoint remains available when unset)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=havcan

# Authentication
AUTH_SESSION_COOKIE=havcan_session
AUTH_SESSION_TTL_SECONDS=1209600
AUTH_PASSWORD_RESET_TTL_SECONDS=3600
AUTH_COOKIE_SECURE=false

# Browser access during local development
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173